generator client {
  provider = "prisma-client-js"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  number   String
  email    String @unique
  password String
  role     String @default("customer")

  Address   Address[]
  favorites Favorite[]
  cartItems CartItem[]
  orders    Order[]
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  category    String
  price       Float
  image       String

  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Address {
  id      Int    @id @default(autoincrement())
  userId  Int
  street  String
  number  Int
  cep     String
  city    String
  state   String
  country String
  type    String @default("home")

  user  User    @relation(fields: [userId], references: [id])
  order Order[]
}

model Favorite {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model CartItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  paymentId   String
  total       Float
  addressId   Int
  createdAt   DateTime    @default(now())
  orderStatus String
  items       OrderItem[]

  user    User    @relation(fields: [userId], references: [id])
  address Address @relation(fields: [addressId], references: [id])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
